default_platform(:ios)

platform :ios do
  desc "Build a signed App Store IPA without uploading it"
  lane :build_release do
    Dir.chdir(File.expand_path("../..", __dir__)) do
      sh("flutter build ipa --release")
    end
  end

  desc "Upload a new build to App Store Connect"
  lane :upload_build do
    api_key = app_store_connect_api_key(
      key_id: "T52YR38D64",
      issuer_id: "947c7ee7-4c99-4b7a-96b7-227a9bf35ed5",
      key_filepath: "/Users/banghuazhao/Development/secret/AppStoreConnect_API_keys/AuthKey_T52YR38D64.p8",
      duration: 1200,
      in_house: false
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      ipa: "../build/ios/ipa/classic_reversi.ipa"
    )
  end

  desc "Update app metadata in App Store Connect"
  lane :update_metadata do
    api_key = app_store_connect_api_key(
      key_id: "T52YR38D64",
      issuer_id: "947c7ee7-4c99-4b7a-96b7-227a9bf35ed5",
      key_filepath: "/Users/banghuazhao/Development/secret/AppStoreConnect_API_keys/AuthKey_T52YR38D64.p8",
      duration: 1200,
      in_house: false
    )

    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      run_precheck_before_submit: false,
      force: true # Skip the HTML report verification
    )
  end

  desc "Upload build + metadata and submit the new version for review"
  lane :prepare_release do |options|
    api_key = app_store_connect_api_key(
      key_id: "T52YR38D64",
      issuer_id: "947c7ee7-4c99-4b7a-96b7-227a9bf35ed5",
      key_filepath: "/Users/banghuazhao/Development/secret/AppStoreConnect_API_keys/AuthKey_T52YR38D64.p8",
      duration: 1200,
      in_house: false
    )

    if options[:inspect_only]
      app = Spaceship::ConnectAPI::App.find("com.appsbay.classicReversi")
      version = app.get_edit_app_store_version(
        platform: Spaceship::ConnectAPI::Platform::IOS
      )
      missing = version.get_app_store_version_localizations
        .select { |localization| localization.whats_new.to_s.strip.empty? }
        .map(&:locale)
        .sort
      UI.message("App Store state: #{version.app_store_state}")
      UI.message("Missing What's New locales: #{missing.join(', ')}")
      next
    end

    upload_to_app_store(
      api_key: api_key,
      ipa: "../build/ios/ipa/classic_reversi.ipa",
      skip_binary_upload: options[:skip_binary_upload] || false,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      phased_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      force: true
    )
  end
end
